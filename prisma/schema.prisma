generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DiscordUser {
  id            String    @id
  username      String
  violations    WarnAttempt[]
}
model WarnAttempt {

  id            Int       @id @default(autoincrement())
  userId        String
  @@index([userId])
  createdAt     DateTime @default(now())
  user          DiscordUser @relation(fields: [userId],references: [id])
  threadName    String
  attemptCount  Int
}